# API key for the OpenAI-compatible endpoint, e.g. from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-REPLACE_ME

# OpenAI-compatible endpoint. Hosted by default; use http://localhost:8000/v1 for a self-hosted NIM or vLLM.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model roles
CSR_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b
# Fast model: structured extraction and per-item judgements
CSR_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
# Turn on the reasoning model's thinking mode (slower, sometimes better)
CSR_THINKING=false
CSR_TEMPERATURE=0.2
# Default output token limit per call
CSR_MAX_TOKENS=4096
